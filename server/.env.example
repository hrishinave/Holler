# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- BYOK via OpenRouter -------------------------------------------------
# One key for every model. Pick a slug from https://openrouter.ai/models
# (append ":free" for a free-tier variant when one exists). Code never changes.
#   MODEL=google/gemini-3.5-flash-lite       # cheaper, weaker at tool-calling
#   MODEL=anthropic/claude-opus-4            # paid, best reliability
MODEL=google/gemini-3.6-flash

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Override only if self-hosting a gateway; the default is OpenRouter's endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Composio (calendar + gmail) -----------------------------------------
COMPOSIO_API_KEY=
# The entity whose Google Calendar + Gmail are connected in Composio.
COMPOSIO_ENTITY_ID=pg-test-d8d9bbf0-b2e9-4444-ba2d-8f37a061b1a7

# --- Web search (Tavily) -------------------------------------------------
# Free-tier key (1000 searches/mo) at https://app.tavily.com
TAVILY_API_KEY=

# --- Assistant defaults ---------------------------------------------------
HOME_TIMEZONE=America/Chicago
