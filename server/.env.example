# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- BYOK: any OpenAI-compatible LLM endpoint ----------------------------
# A provider is just a base URL + key + model name; the code never changes.
#
# Default below: Google Gemini's OpenAI-compat endpoint (direct key, generous
# free tier; get a key at https://aistudio.google.com/apikey).
# Alternatives:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  MODEL=google/gemini-3.6-flash
#   Local:      LLM_BASE_URL=http://localhost:11434/v1     MODEL=llama3.3   (Ollama)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
MODEL=gemini-3.6-flash

# --- Composio (calendar + gmail) -----------------------------------------
COMPOSIO_API_KEY=
# The entity whose Google Calendar + Gmail are connected in Composio.
COMPOSIO_ENTITY_ID=pg-test-d8d9bbf0-b2e9-4444-ba2d-8f37a061b1a7

# --- Web search (Tavily) -------------------------------------------------
# Free-tier key (1000 searches/mo) at https://app.tavily.com
TAVILY_API_KEY=

# --- Telegram (Phase 4) --------------------------------------------------
# Create a bot with @BotFather to get this token.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot. Leave empty to allow anyone
# (UNSAFE — this bot touches your real Gmail/Calendar). Message the bot once and
# check the logs / getUpdates to learn your chat id, then lock it down here.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Proactive email monitor ---------------------------------------------
# Watches your inbox and pings you about important mail. Off by default; it
# sends unprompted messages, so enable only when you're ready.
EMAIL_MONITOR_ENABLED=false
# Chat to notify (defaults to the first TELEGRAM_ALLOWED_CHAT_IDS entry).
OWNER_CHAT_ID=
# Hours after flagging an email to send ONE chill follow-up (only if it still
# looks unhandled). 0 disables follow-ups.
EMAIL_FOLLOWUP_HOURS=3

# --- Assistant defaults ---------------------------------------------------
HOME_TIMEZONE=America/Chicago
